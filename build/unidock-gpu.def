Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# ============================================================
# unidock-gpu.def
# Apptainer Definition File – Docking Container (GPU)
# Uni-Dock (Stufe 2 der Pipeline) – sonst nichts
#
# Loest docking-gpu.def ab. Entfallen sind gegenueber der
# Vina-GPU+-Variante:
#   - Boost 1.77 Quellbau
#   - Vina-GPU-2.0 Clone + Makefile-Patch
#   - patch_kernels.py und die OpenCL-Kernel-Patches
#   - /opt/vina-opencl mit Architektur-Unterordnern
#   - OpenCL ICD Konfiguration
# Uni-Dock kommt als vorgebautes conda-forge-Paket.
#
# Build:
#   apptainer build unidock-gpu.sif unidock-gpu.def
#
# Voraussetzungen im Build-Verzeichnis:
#   pipeline_common.py   ← geteilte Basis
#   docking_config.py    ← Config der Docking-Stufe
#   unidock_engine.py    ← Uni-Dock Batch-Engine
#   worker_dock.py       ← Docking-Worker
#   worker_restart_dock.py
#
# Kein gnina, kein docking_rescore, kein RDKit/OpenBabel/AutoDockTools:
# Aufbereitung laeuft in sdf_to_pdbqt.sif, Rescoring in rescoring-gpu.sif.
# ============================================================

%labels
    maintainer    Docking Pipeline
    description   Uni-Dock GPU Docking Container (CUDA 12.4), Stufe 2
    version       4.0

%environment
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_DIR=/opt/miniconda3
    export ENV_NAME=docking_env
    export PATH=/opt/miniconda3/envs/docking_env/bin:/opt/miniconda3/bin:$PATH
    export PIPELINE_DIR=/app
    export UNIDOCK_BINARY=/opt/miniconda3/envs/docking_env/bin/unidock

%files
    pipeline_common.py       /app/pipeline_common.py
    docking_config.py        /app/docking_config.py
    unidock_engine.py        /app/unidock_engine.py
    worker_dock.py           /app/worker_dock.py
    worker_restart_dock.py   /app/worker_restart_dock.py

%post -c /bin/bash
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_DIR=/opt/miniconda3
    export ENV_NAME=docking_env
    export PATH=/opt/miniconda3/bin:$PATH

    # ── System-Pakete ─────────────────────────────────────
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        wget curl git \
        build-essential \
        ca-certificates \
        libgomp1 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # ── Miniconda ─────────────────────────────────────────
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
        -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p ${CONDA_DIR}
    rm /tmp/miniconda.sh
    conda clean -afy

    echo "source ${CONDA_DIR}/etc/profile.d/conda.sh" >> /etc/bash.bashrc
    echo "conda activate ${ENV_NAME}" >> /etc/bash.bashrc

    # ── Conda Netzwerk-Robustheit ─────────────────────────
    /opt/miniconda3/bin/conda config --set remote_max_retries 10
    /opt/miniconda3/bin/conda config --set remote_backoff_factor 2
    /opt/miniconda3/bin/conda config --set remote_connect_timeout_secs 60
    /opt/miniconda3/bin/conda config --set remote_read_timeout_secs 300

    # ── Conda TOS akzeptieren ─────────────────────────────
    /opt/miniconda3/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/main || true
    /opt/miniconda3/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/r || true

    # ── Conda Environment ─────────────────────────────────
    . ${CONDA_DIR}/etc/profile.d/conda.sh
    conda config --env --add channels conda-forge
    conda config --env --set channel_priority strict
    conda create -n ${ENV_NAME} python=3.11 -y -q
    conda clean -afy

    conda install -n ${ENV_NAME} -y -q \
        -c conda-forge --override-channels \
        numpy pandas scipy matplotlib scikit-learn joblib
    conda clean -afy

    # ── Uni-Dock ──────────────────────────────────────────
    for i in 1 2 3; do
        conda install -n ${ENV_NAME} -y -q \
            -c conda-forge --override-channels \
            unidock && break || \
        (echo "Uni-Dock Versuch $i fehlgeschlagen, warte 30s..." && sleep 30)
    done
    conda clean -afy

    conda activate ${ENV_NAME}

    # ── Pipeline Verzeichnis ──────────────────────────────
    mkdir -p /app /workspace

    # ── Verifikation ──────────────────────────────────────
    # ACHTUNG: hier laeuft kein GPU-Test – der Build-Host hat i.d.R.
    # keine GPU. Der sm_90-Test steht in MIGRATION.md und muss nach
    # dem Build einmal auf einer H100 ausgefuehrt werden.
    python3 -c "
import numpy as np
print(f'OK numpy {np.__version__}')
"
    which unidock
    unidock --help > /dev/null 2>&1 && echo "OK Uni-Dock Binary" || \
        echo "WARNUNG: unidock --help ohne GPU nicht ausfuehrbar (erwartet)"
    echo "Uni-Dock Container - Pakete verifiziert"

    # ── Entrypoint ────────────────────────────────────────
    cat > /entrypoint.sh << 'ENTRY'
#!/bin/bash
source /opt/miniconda3/etc/profile.d/conda.sh
conda activate docking_env
ulimit -s 8192 2>/dev/null || true
exec "$@"
ENTRY
    chmod +x /entrypoint.sh

%runscript
    . /opt/miniconda3/etc/profile.d/conda.sh
    conda activate docking_env
    exec python /app/worker_dock.py "$@"
