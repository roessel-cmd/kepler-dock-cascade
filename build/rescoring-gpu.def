Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# ============================================================
# rescoring-gpu.def
# Apptainer Definition File – Rescoring Container (GPU)
# PyTorch + gninatorch + molgrid | gnina CLI Fallback
# Plus: ΔLin_F9XGB (Lin_F9 + XGBoost Δ-Learning)
#
# Dieser Container ist fuer CNN-Rescoring (CNNscore + CNNaffinity)
# UND fuer ΔLin_F9XGB-Rescoring. Docking laeuft im separaten
# docking-gpu.sif Container.
#
# Zwei conda-Environments:
#   rescore_env   → PyTorch + gninatorch (Python 3.11)
#   linf9xgb_env  → ΔLin_F9XGB Toolkit  (Python 3.7, alte rdkit/scipy)
#
# Kein Vina-GPU+, kein OpenCL, kein Boost → schlankes Image.
#
# Build:
#   apptainer build rescoring-gpu.sif rescoring-gpu.def
#
# Voraussetzungen im Build-Verzeichnis:
#   gnina              ← gnina Binary (Fallback)
#   docking_*.py       ← Pipeline Scripts
#   gnina_gpu_worker.py
#   linf9xgb_scorer.py ← ΔLin_F9XGB Wrapper
#
# Internet-Zugang waehrend des Builds noetig fuer:
#   - Miniconda Installer
#   - PyPI / conda-forge Pakete
#   - git clone https://github.com/cyangNYU/delta_LinF9_XGB
#   - MGLTools-Download von Scripps
#
# Start (ueber Orchestrator):
#   apptainer exec --nv rescoring-gpu.sif /entrypoint.sh \
#     python /app/worker_gpu.py
# ============================================================

%labels
    maintainer    Docking Pipeline
    description   CNN Rescoring Container - gninatorch GPU (CUDA 12.4)
    version       3.0

%environment
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_DIR=/opt/miniconda3
    export ENV_NAME=rescore_env
    export PATH=/opt/miniconda3/bin:$PATH
    export PIPELINE_DIR=/app
    export GNINA_BINARY=/usr/local/bin/gnina
    # ΔLin_F9XGB
    export LINF9XGB_DIR=/opt/delta_LinF9_XGB
    export LINF9XGB_ENV=linf9xgb_env
    export MGLTOOLS_DIR=/opt/mgltools

%files
    gnina                    /usr/local/bin/gnina
    worker_rescore.py        /app/worker_rescore.py
    docking_rescore.py       /app/docking_rescore.py
    gnina_refinement.py      /app/gnina_refinement.py
    gnina_gpu_worker.py      /app/gnina_gpu_worker.py
    linf9xgb_scorer.py       /app/linf9xgb_scorer.py
    # Gepatchtes featureSASA.py mit subprocess.run + Timeouts.
    # Loest den pdb_to_xyzr-Haenger (verlorener SIGCHLD im Container ohne
    # Init-Prozess bei parallelen Workern). Wird in %post nach dem
    # delta_LinF9_XGB-Clone an die richtige Stelle kopiert.
    # WICHTIG: nicht nach /tmp - das wird waehrend %post ueberschrieben.
    featureSASA.py           /opt/featureSASA_patched.py
    # Gepatchtes prepare_betaAtoms.py: gleiche Hänger-Klasse, fuer den
    # pythonsh prepare_receptor4.py Aufruf. Verwendet zusaetzlich
    # start_new_session + os.killpg um auch die MGLTools-Python-Enkel zu
    # erwischen, nicht nur die /bin/sh.
    prepare_betaAtoms.py     /opt/prepare_betaAtoms_patched.py

%post -c /bin/bash
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_DIR=/opt/miniconda3
    export ENV_NAME=rescore_env
    export PATH=/opt/miniconda3/bin:$PATH

    # ── System-Pakete (minimal) ───────────────────────────
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        wget curl git bzip2 \
        build-essential \
        ca-certificates \
        libgomp1 \
        libopenbabel-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

    # ── Miniconda ─────────────────────────────────────────
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh \
        -O /tmp/miniconda.sh
    bash /tmp/miniconda.sh -b -p ${CONDA_DIR}
    rm /tmp/miniconda.sh
    conda clean -afy

    echo "source ${CONDA_DIR}/etc/profile.d/conda.sh" >> /etc/bash.bashrc
    echo "conda activate ${ENV_NAME}" >> /etc/bash.bashrc

    # ── Conda Netzwerk-Robustheit ─────────────────────────
    /opt/miniconda3/bin/conda config --set remote_max_retries 10
    /opt/miniconda3/bin/conda config --set remote_backoff_factor 2
    /opt/miniconda3/bin/conda config --set remote_connect_timeout_secs 60
    /opt/miniconda3/bin/conda config --set remote_read_timeout_secs 300

    # ── Conda TOS akzeptieren ─────────────────────────────
    /opt/miniconda3/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/main || true
    /opt/miniconda3/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/r || true

    # ── Conda Environment ─────────────────────────────────
    # Minimales Environment: Python + pip + joblib (fuer CLI-Fallback)
    # WICHTIG: pip muss explizit installiert werden – conda-forge im
    # strict-channel-Modus liefert es sonst nicht mit.
    . ${CONDA_DIR}/etc/profile.d/conda.sh
    conda config --env --add channels conda-forge
    conda config --env --set channel_priority strict
    conda create -n ${ENV_NAME} python=3.11 pip -y -q
    conda clean -afy

    # Smoke-Check: pip muss da sein, sonst brechen wir hier ab statt
    # erst spaeter mit kryptischer Fehlermeldung
    test -x /opt/miniconda3/envs/${ENV_NAME}/bin/pip || {
        echo "FEHLER: pip nicht in ${ENV_NAME} installiert"
        exit 1
    }

    conda install -n ${ENV_NAME} -y -q \
        -c conda-forge --override-channels \
        joblib pandas
    conda clean -afy

    # ── PyTorch (CUDA 12.4) ───────────────────────────────
    # ALLES per pip: kein conda-numpy, kein MKL-Konflikt.
    # PyTorch bringt eigenes numpy mit (als Dependency).
    # WICHTIG: Wir nutzen den expliziten env-pip statt 'conda activate',
    # weil set -e + Subshells 'conda activate' brueckeln koennen.
    RESCORE_PIP=/opt/miniconda3/envs/${ENV_NAME}/bin/pip
    RESCORE_PY=/opt/miniconda3/envs/${ENV_NAME}/bin/python

    ${RESCORE_PIP} install --no-cache-dir \
        torch torchvision \
        --index-url https://download.pytorch.org/whl/cu124
    ${RESCORE_PIP} install --no-cache-dir nvidia-cusparselt-cu12
    echo "/opt/miniconda3/envs/${ENV_NAME}/lib/python3.11/site-packages/nvidia/cusparselt/lib" \
        > /etc/ld.so.conf.d/nvidia-cusparselt.conf
    ldconfig

    # ── gninatorch + molgrid ──────────────────────────────
    ${RESCORE_PIP} install --no-cache-dir gninatorch
    # molgrid erfordert numpy<2 → pip's numpy downgraden
    # Kein MKL-Konflikt hier: conda hat kein eigenes numpy installiert,
    # alles kommt von pip (torch → numpy) → konsistentes Backend.
    ${RESCORE_PIP} install --no-cache-dir 'numpy>=1.26,<2'

    # ── gnina CLI (Fallback) ──────────────────────────────
    chmod +x /usr/local/bin/gnina

    # ══════════════════════════════════════════════════════════
    #  ΔLin_F9XGB Toolkit
    # ══════════════════════════════════════════════════════════
    # Eigenes Conda-Environment, weil das Toolkit Python 3.7 +
    # alte rdkit/scipy/xgboost Versionen braucht (Inkompatibel
    # mit dem PyTorch/gninatorch Stack im rescore_env).

    # Repo klonen (enthaelt Smina-Lin_F9 Binary, MSMS-Tarball,
    # AlphaSpace2-Tarball, alle Skripte, saved_model)
    cd /opt && git clone --depth 1 \
        https://github.com/cyangNYU/delta_LinF9_XGB.git
    cd /opt/delta_LinF9_XGB

    # MSMS herunterladen (NICHT im Repo enthalten)
    cd /opt/delta_LinF9_XGB/software
    wget -q https://ccsb.scripps.edu/msms/download/933/msms_i86_64Linux2_2.6.1.tar.gz \
        -O msms_i86_64Linux2_2.6.1.tar.gz
    mkdir -p msms
    tar --no-same-owner -zxf msms_i86_64Linux2_2.6.1.tar.gz -C msms
    cd msms
    if [ -f msms.x86_64Linux2.2.6.1 ]; then
        cp msms.x86_64Linux2.2.6.1 msms
        chmod +x msms
    fi
    # Den absoluten Pfad in pdb_to_xyzr eintragen (Repo erwartet das)
    sed -i 's|numfile="./atmtypenumbers"|numfile="/opt/delta_LinF9_XGB/software/atmtypenumbers"|' \
        pdb_to_xyzr || true

    # Smina-Binaries ausfuehrbar machen
    chmod +x /opt/delta_LinF9_XGB/software/smina_feature || true
    chmod +x /opt/delta_LinF9_XGB/software/smina.static || true

    # ── MGLTools (NICHT im Repo enthalten) ────────────────
    # Wird von prepare_receptor4.py / prepare_ligand4.py gebraucht.
    # Scripps Download-Link, statisches Tarball.
    cd /tmp
    wget -q https://ccsb.scripps.edu/mgltools/download/491/mgltools_x86_64Linux2_1.5.7.tar.gz \
        -O mgltools.tar.gz
    mkdir -p /opt/mgltools
    tar --no-same-owner -zxf mgltools.tar.gz -C /opt/mgltools --strip-components=1

    # Sub-Archive manuell entpacken (Original-install.sh braucht TTY/Input,
    # macht aber eigentlich nur tar -xzf der Sub-Archive plus Symlinks).
    cd /opt/mgltools
    for arc in MGLToolsPckgs.tar.gz Python2.7_x86_64Linux2.tar.gz \
               Data.tar.gz ThirdPartyPacks.tar.gz; do
        if [ -f "$arc" ]; then
            tar --no-same-owner -zxf "$arc"
            rm -f "$arc"
        fi
    done

    # pythonsh-Wrapper-Skript erstellen (das macht install.sh sonst)
    # WICHTIG: Der MGLTools-Python-2-Interpreter heisst python2.7,
    # nicht python (das ist im Container 1.5.7-Tarball anders als
    # in alten 1.5.6-Versionen).
    cat > /opt/mgltools/bin/pythonsh << 'PYSH'
#!/bin/bash
MGL_ROOT=/opt/mgltools
export PYTHONHOME="$MGL_ROOT"
export PYTHONPATH="$MGL_ROOT/MGLToolsPckgs:$PYTHONPATH"
export LD_LIBRARY_PATH="$MGL_ROOT/lib:$LD_LIBRARY_PATH"
exec "$MGL_ROOT/bin/python2.7" "$@"
PYSH
    chmod +x /opt/mgltools/bin/pythonsh

    # Smoke-Check: prepare_receptor4.py muss da sein
    test -f /opt/mgltools/MGLToolsPckgs/AutoDockTools/Utilities24/prepare_receptor4.py || {
        echo "FEHLER: MGLTools-Sub-Archive nicht entpackt"
        ls /opt/mgltools/
        exit 1
    }
    rm -f /tmp/mgltools.tar.gz

    # ── ΔLin_F9XGB Conda-Environment (Python 3.7) ─────────
    # pip explizit, sonst fehlt es im strict-channel-Modus
    . ${CONDA_DIR}/etc/profile.d/conda.sh
    conda create -n linf9xgb_env python=3.7 pip -y -q
    conda clean -afy

    # Smoke-Check
    test -x /opt/miniconda3/envs/linf9xgb_env/bin/pip || {
        echo "FEHLER: pip nicht in linf9xgb_env installiert"
        exit 1
    }

    # Versionen exakt wie im Paper / Repo-README
    conda install -n linf9xgb_env -y -q \
        -c conda-forge --override-channels \
        pandas=1.3.0 scipy=1.5.3 rdkit=2020.09.5 \
        openbabel=3.1.0 mdtraj
    conda clean -afy

    # xgboost==1.2.0 nur via pip (conda hat es nicht in der Version)
    conda run -n linf9xgb_env pip install --no-cache-dir xgboost==1.2.0

    # AlphaSpace2 lokal installieren (aus mitgeliefertem Tarball)
    cd /opt/delta_LinF9_XGB/software
    if [ -f AlphaSpace2_2021.tar.gz ]; then
        tar --no-same-owner -zxf AlphaSpace2_2021.tar.gz
        cd AlphaSpace2_2021
        conda run -n linf9xgb_env pip install --no-cache-dir -e ./
    fi

    # ── Pfade in den Repo-Skripten patchen ────────────────
    # Das Repo nutzt absolute Pfade von Chao Yangs Workstation –
    # die muessen auf unsere Container-Pfade umgebogen werden.
    cd /opt/delta_LinF9_XGB
    OLD_PATH="/home/cyang/paper_XGB/delta_LinF9_XGB"
    NEW_PATH="/opt/delta_LinF9_XGB"
    OLD_MGL="/home/cyang/MGLTools-1.5.6"
    NEW_MGL="/opt/mgltools"
    for f in script/runXGB.py script/calc_vina_features.py \
             script/prepare_betaAtoms.py script/featureSASA.py \
             script/calc_bridge_wat.py; do
        if [ -f "$f" ]; then
            sed -i "s|${OLD_PATH}|${NEW_PATH}|g" "$f"
            sed -i "s|${OLD_MGL}|${NEW_MGL}|g" "$f"
        fi
    done

    # ── ADT-Variable so umbiegen dass sie via pythonsh laeuft ──
    # Im Original wird ADT direkt aufgerufen (os.system(ADT + " -r ...")),
    # was Python 3 auf einem Python 2 Skript triggert → SyntaxError.
    # Fix: pythonsh voranstellen, der startet MGLTools' Python 2.7.
    OLD_ADT="ADT = '/opt/mgltools/MGLToolsPckgs/AutoDockTools/Utilities24/prepare_receptor4.py'"
    NEW_ADT="ADT = '/opt/mgltools/bin/pythonsh /opt/mgltools/MGLToolsPckgs/AutoDockTools/Utilities24/prepare_receptor4.py'"
    for f in script/runXGB.py script/prepare_betaAtoms.py; do
        if [ -f "$f" ] && grep -q "^ADT = '/opt/mgltools/MGLToolsPckgs" "$f"; then
            sed -i "s|${OLD_ADT}|${NEW_ADT}|" "$f"
            echo "  ADT gepatcht: $f"
        fi
    done

    # ── featureSASA.py: Subprocess-Timeout-Fix + Race-Fix ─────
    # Wir ersetzen das Original durch eine bereits vollstaendig gepatchte
    # Version (siehe %files: featureSASA.py → /tmp/featureSASA_patched.py).
    #
    # Die gepatchte Version enthaelt:
    #   1. tempfile.mkdtemp() pro runMSMS-Aufruf (bisheriger Race-Fix)
    #   2. subprocess.run() mit Timeout statt os.system() fuer alle
    #      externen Tool-Aufrufe (pdb_to_xyzr, msms). Das loest den
    #      'do_wait'-Haenger in /bin/sh: Apptainer-Container haben kein
    #      PID-1-Init, das SIGCHLD reapt - bei parallelen Workern gehen
    #      Signale verloren und os.system bleibt fuer Stunden in wait()
    #      stecken. subprocess.run(..., timeout=N) sendet bei Timeout
    #      SIGKILL und kommt garantiert zurueck.
    #   3. Native Python statt mkdir/cp/cat/sed Subprocesses (kleiner
    #      Speedup, keine numerische Aenderung).
    #
    # Numerische Identitaet zur Original-Implementierung: Tools werden
    # mit identischen Argumenten aufgerufen, nur ueber subprocess.run
    # statt os.system. Bei nicht-haengenden Posen bit-identischer Output.
    # Bei haengenden Posen: Timeout → None-Score statt blockierter Worker.
    test -f /opt/featureSASA_patched.py || {
        echo "FEHLER: /opt/featureSASA_patched.py nicht gefunden."
        echo "        featureSASA.py muss im Build-Verzeichnis liegen."
        exit 1
    }
    cp /opt/featureSASA_patched.py /opt/delta_LinF9_XGB/script/featureSASA.py
    rm /opt/featureSASA_patched.py

    # Verifikation: Patch muss tatsaechlich aktiv sein
    python3 << 'PYVERIFY'
import ast
p = "/opt/delta_LinF9_XGB/script/featureSASA.py"
src = open(p).read()
ast.parse(src)  # Syntax-Check
assert "subprocess.run" in src, "Patch fehlt: subprocess.run nicht gefunden"
assert "_PDB_TO_XYZR_TIMEOUT" in src, "Patch fehlt: Timeout-Konstante nicht da"
assert "tempfile.mkdtemp" in src, "Race-Fix fehlt: tempfile.mkdtemp nicht da"
# Es darf keine echten os.system/os.popen-Aufrufe mehr geben.
# Erlaubt sind nur Vorkommen in Kommentaren/Docstrings.
import re
for m in re.finditer(r'^[^#\n]*os\.(system|popen)\s*\(', src, re.MULTILINE):
    raise AssertionError(
        f"os.system/os.popen noch im Code (Position {m.start()}): "
        f"{src[max(0,m.start()-20):m.start()+60]!r}"
    )
print("  featureSASA.py: gepatchte Version installiert und verifiziert")
PYVERIFY

    # ── prepare_betaAtoms.py: Subprocess-Timeout-Fix ──────────
    # Selbe Haenger-Klasse wie featureSASA.py, aber andere Stelle:
    # 'pythonsh prepare_receptor4.py' (MGLTools) blockiert dauerhaft
    # in /bin/sh wait() wenn SIGCHLD verloren geht.
    # Hier zusaetzlich Process-Group-Kill noetig: pythonsh ist ein
    # bash-Wrapper -> python2.7. Naive subprocess.run(timeout=N) kuemmert
    # sich nur um die direkte Shell, nicht um die python-Enkel - die
    # wuerden weiter laufen. Patch verwendet start_new_session + killpg.
    test -f /opt/prepare_betaAtoms_patched.py || {
        echo "FEHLER: /opt/prepare_betaAtoms_patched.py nicht gefunden."
        echo "        prepare_betaAtoms.py muss im Build-Verzeichnis liegen."
        exit 1
    }
    cp /opt/prepare_betaAtoms_patched.py \
       /opt/delta_LinF9_XGB/script/prepare_betaAtoms.py
    rm /opt/prepare_betaAtoms_patched.py

    # Erneut: ADT-Variable so umbiegen dass sie via pythonsh laeuft.
    # Der frische Patch hat den Original-ADT wieder drin (siehe oben
    # Zeile ~280 fuer die Original-sed-Edits). Nochmal anwenden.
    OLD_ADT="ADT = '/opt/mgltools/MGLToolsPckgs/AutoDockTools/Utilities24/prepare_receptor4.py'"
    NEW_ADT="ADT = '/opt/mgltools/bin/pythonsh /opt/mgltools/MGLToolsPckgs/AutoDockTools/Utilities24/prepare_receptor4.py'"
    if grep -q "^ADT = '/opt/mgltools/MGLToolsPckgs" /opt/delta_LinF9_XGB/script/prepare_betaAtoms.py; then
        sed -i "s|${OLD_ADT}|${NEW_ADT}|" /opt/delta_LinF9_XGB/script/prepare_betaAtoms.py
        echo "  ADT-Patch nach Replace erneut angewendet."
    fi

    # Verifikation
    python3 << 'PYVERIFY2'
import ast, re
p = "/opt/delta_LinF9_XGB/script/prepare_betaAtoms.py"
src = open(p).read()
ast.parse(src)
assert "subprocess.Popen" in src, "Patch fehlt: subprocess.Popen nicht da"
assert "start_new_session" in src, "Patch fehlt: start_new_session fehlt"
assert "os.killpg" in src, "Patch fehlt: killpg fehlt"
assert "/opt/mgltools/bin/pythonsh" in src, \
    "ADT-Pfad nicht korrekt umgebogen"
for m in re.finditer(r'^[^#\n]*os\.(system|popen)\s*\(', src, re.MULTILINE):
    raise AssertionError(
        f"os.system/os.popen noch im Code: "
        f"{src[max(0,m.start()-20):m.start()+60]!r}"
    )
print("  prepare_betaAtoms.py: gepatchte Version installiert "
      "und verifiziert")
PYVERIFY2

    # ── Pipeline Verzeichnis ──────────────────────────────
    mkdir -p /app /workspace

    # ── Verifikation ─────────────────────────────────────
    # Explizite Python-Pfade nutzen (siehe oben: conda activate kann
    # in Subshells brueckeln)
    /opt/miniconda3/envs/${ENV_NAME}/bin/python -c "
import torch
print(f'OK PyTorch {torch.__version__}')
print(f'   CUDA verfuegbar: {torch.cuda.is_available()}')
if torch.cuda.is_available():
    print(f'   GPU: {torch.cuda.get_device_name(0)}')

import numpy as np
print(f'OK numpy {np.__version__}')

from gninatorch.gnina import setup_gnina_model
print('OK gninatorch')

import molgrid
print('OK molgrid')

print('Rescoring Container - rescore_env verifiziert')
"

    # ΔLin_F9XGB-Environment verifizieren
    /opt/miniconda3/envs/linf9xgb_env/bin/python -c "
import xgboost, pandas, scipy, rdkit, mdtraj
print(f'OK xgboost {xgboost.__version__}')
print(f'OK pandas  {pandas.__version__}')
print(f'OK scipy   {scipy.__version__}')
print(f'OK rdkit   {rdkit.__version__}')
print(f'OK mdtraj  {getattr(mdtraj, \"__version__\", \"unknown\")}')
import os
assert os.path.isfile('/opt/delta_LinF9_XGB/script/runXGB.py'), 'runXGB.py fehlt!'
assert os.path.isfile('/opt/delta_LinF9_XGB/software/smina.static'), 'smina.static fehlt!'
assert os.path.isdir('/opt/delta_LinF9_XGB/saved_model'), 'saved_model/ fehlt!'
print('OK ΔLin_F9XGB Toolkit verifiziert')
"

    # ── Entrypoint ────────────────────────────────────────
    cat > /entrypoint.sh << 'ENTRY'
#!/bin/bash
source /opt/miniconda3/etc/profile.d/conda.sh
conda activate rescore_env
exec "$@"
ENTRY
    chmod +x /entrypoint.sh

%runscript
    . /opt/miniconda3/etc/profile.d/conda.sh
    conda activate rescore_env
    exec python /app/docking_rescore.py "$@"

%startscript
    . /opt/miniconda3/etc/profile.d/conda.sh
    conda activate rescore_env
    exec python /app/docking_rescore.py "$@"
